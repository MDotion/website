---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="MDotion — Visual Markdown editor for VS Code and Cursor"
  description="Edit Markdown like a page in VS Code and Cursor: slash menu, drag-and-drop blocks, tables pasted from Excel or Google Sheets, find and replace, and the changes since your last commit. Files stay plain .md, untouched blocks are saved byte for byte."
>
  <Header />
  <main>
    <Hero />
    <Bento />
    <Install />
    <Faq />
  </main>
  <Footer />
</Base>
