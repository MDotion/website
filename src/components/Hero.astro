---
import EditorDemo from './EditorDemo.astro';
import { links } from '../links';
---

<section class="hero">
  <div class="container">
    <div class="intro">
      <a class="news enter" href="#changes">
        <span class="news-tag">New in 0.3</span>
        <span class="news-text">See what changed since your last commit</span>
        <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <h1 class="display enter">Markdown, edited like&nbsp;a&nbsp;page.</h1>
      <p class="lead enter">
        MDotion is a block editor for <code>.md</code> files. Slash menu, drag-and-drop blocks, an outline to reorder
        sections and tables you can paste from a spreadsheet, while the file on disk stays plain Markdown.
      </p>
      <div class="actions enter">
        <a class="button button-primary" href={links.marketplace}>Install for VS Code</a>
        <a class="button button-secondary" href={links.openVsx}>Install for Cursor</a>
      </div>
      <p class="meta enter">Free and open source · No account · No telemetry</p>
    </div>

    <div class="stage enter">
      <EditorDemo />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .intro {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .display {
    margin-top: 14px;
  }

  .lead {
    max-width: 560px;
    text-wrap: balance;
    margin: 20px auto 0;
  }

  .lead code {
    font-size: 0.9em;
    color: var(--ink);
  }

  /* What's new: a quiet link above the title. */
  .news {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 4px 12px 4px 4px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: var(--surface-shadow);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out),
      color 150ms ease;
  }

  .news:active {
    transform: scale(0.98);
  }

  .news-tag {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
  }

  .news-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .news svg {
    flex: none;
    color: var(--text-tertiary);
    transition:
      transform 200ms var(--ease-out),
      color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .news:hover {
      color: var(--ink);
    }

    .news:hover svg {
      color: var(--ink);
      transform: translateX(2px);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .meta {
    margin-top: 16px;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .stage {
    max-width: 880px;
    margin: clamp(48px, 7vw, 80px) auto 0;
  }

  /* First load only: a short cascade, run as a CSS animation so it stays
     smooth while the page is still loading. */
  .enter {
    animation: enter 600ms var(--ease-out) both;
  }

  .enter:nth-child(2) {
    animation-delay: 50ms;
  }
  .enter:nth-child(3) {
    animation-delay: 100ms;
  }
  .enter:nth-child(4) {
    animation-delay: 150ms;
  }
  .enter:nth-child(5) {
    animation-delay: 200ms;
  }
  .enter:nth-child(6) {
    animation-delay: 250ms;
  }
  .stage.enter {
    animation-delay: 260ms;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news:active {
      transform: none;
    }

    .enter {
      animation-name: fade;
      animation-duration: 300ms;
    }

    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }

  @media (max-width: 640px) {
    .actions .button {
      flex: 1 1 100%;
    }
  }
</style>
