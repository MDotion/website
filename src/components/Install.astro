---
import { installCommand, links } from '../links';

const stores = [
  {
    href: links.marketplace,
    title: 'Visual Studio Marketplace',
    body: 'For VS Code 1.85 or later.',
  },
  {
    href: links.openVsx,
    title: 'Open VSX',
    body: 'For Cursor, VSCodium and other editors built on VS Code.',
  },
];
---

<section class="section install" id="install">
  <div class="container">
    <div class="panel">
      <div class="head">
        <h2 class="section-title">Install MDotion</h2>
        <p class="lead">
          It never takes over your Markdown on its own. Open a <code>.md</code> file and click the book icon, or let it become
          your default editor when it asks.
        </p>
      </div>

      <div class="stores">
        {
          stores.map((s) => (
            <a class="store" href={s.href}>
              <span class="store-title">
                {s.title}
                <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M5 11 11 5M6 5h5v5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="store-body">{s.body}</span>
            </a>
          ))
        }
      </div>

      <div class="command">
        <span class="command-label">Or paste this into Quick Open (⌘P / Ctrl+P)</span>
        <div class="command-row">
          <code>{installCommand}</code>
          <button type="button" class="copy" data-copy={installCommand}>
            <span class="copy-label" data-state="idle">Copy</span>
            <span class="copy-label" data-state="done" aria-hidden="true">Copied</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 20px;
    background: var(--bg-subtle);
  }

  .head .lead {
    max-width: 560px;
    margin-top: 12px;
  }

  .head code {
    color: var(--ink);
  }

  .stores {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .store {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 20px;
    border-radius: 12px;
    background: var(--bg);
    box-shadow: var(--surface-shadow);
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out),
      box-shadow 150ms ease;
  }

  .store:active {
    transform: scale(0.98);
  }

  .store-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .store-title svg {
    flex: none;
    color: var(--text-tertiary);
    transition:
      transform 200ms var(--ease-out),
      color 150ms ease;
  }

  .store-body {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .store:hover .store-title svg {
      color: var(--ink);
      transform: translate(2px, -2px);
    }
  }

  .command {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .command-label {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .command-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-radius: 10px;
    background: var(--bg);
    box-shadow: var(--surface-shadow);
  }

  .command-row code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Both labels share one cell; the button keeps the width of the longer one. */
  .copy {
    display: grid;
    flex: none;
    height: 32px;
    padding-inline: 12px;
    border: 0;
    border-radius: 7px;
    background: var(--hover);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease;
  }

  .copy:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      background: color-mix(in srgb, var(--ink) 10%, transparent);
    }
  }

  .copy-label {
    grid-area: 1 / 1;
    align-self: center;
    transition:
      opacity 200ms ease,
      filter 200ms ease;
  }

  .copy-label[data-state='done'],
  .copy[data-copied] .copy-label[data-state='idle'] {
    opacity: 0;
    filter: blur(2px);
  }

  .copy[data-copied] .copy-label[data-state='done'] {
    opacity: 1;
    filter: none;
  }

  @media (max-width: 640px) {
    .stores {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store:active,
    .copy:active {
      transform: none;
    }

    .copy-label {
      filter: none !important;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy[data-copy]')) {
    let timer: number | undefined;
    const [idle, done] = button.querySelectorAll<HTMLElement>('.copy-label');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
      } catch {
        return;
      }
      button.toggleAttribute('data-copied', true);
      idle.setAttribute('aria-hidden', 'true');
      done.removeAttribute('aria-hidden');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.toggleAttribute('data-copied', false);
        done.setAttribute('aria-hidden', 'true');
        idle.removeAttribute('aria-hidden');
      }, 1600);
    });
  }
</script>
