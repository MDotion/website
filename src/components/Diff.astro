---
type Row = { n: number | null; kind: ' ' | '-' | '+'; text: string };

const rows: Row[] = [
  { n: 13, kind: ' ', text: '## Before the release' },
  { n: 14, kind: ' ', text: '' },
  { n: 15, kind: ' ', text: '- [x] Freeze the feature list' },
  { n: 16, kind: ' ', text: '- [x] Update the changelog' },
  { n: 17, kind: '-', text: '- [ ] Record the demo video' },
  { n: 17, kind: '+', text: '- [x] Record the demo video' },
];
---

<section class="section diff-section">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">Plain files, clean history</p>
      <h2 class="section-title">One edit.<br />One line in the diff.</h2>
      <p class="lead">
        MDotion only rewrites the blocks you touch. Everything else is saved byte for byte, so ticking a to-do shows up in
        Git as exactly that.
      </p>
      <ul class="points">
        <li>No reformatting, no normalised lists, no rewrapped paragraphs.</li>
        <li>HTML, reference links and anything the editor can't show stay verbatim.</li>
        <li>Save, undo and Git go through VS Code as usual.</li>
      </ul>
    </div>

    <figure class="diff" aria-label="Git diff of docs/release.md after ticking one to-do">
      <figcaption class="diff-head">
        <span>docs/release.md</span>
        <span class="stat"><span class="add">+1</span> <span class="del">−1</span></span>
      </figcaption>
      <pre><code>
        <span class="hunk">@@ -13,5 +13,5 @@</span>
        {
          rows.map((r) => (
            <span class:list={['row', { add: r.kind === '+', del: r.kind === '-' }]}>
              <span class="n" aria-hidden="true">{r.n}</span>
              <span class="sign">{r.kind}</span>
              <span class="t">{r.text}</span>
            </span>
          ))
        }
      </code></pre>
    </figure>
  </div>
</section>

<style>
  .diff-section {
    padding-top: clamp(80px, 11vw, 144px);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .copy .section-title {
    margin-top: 12px;
  }

  .copy .lead {
    margin-top: 16px;
  }

  .points {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .points li {
    position: relative;
    padding-left: 22px;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--text-tertiary);
  }

  .diff {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg);
    box-shadow: var(--surface-shadow);
  }

  .diff-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--bg-subtle);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .stat .add {
    color: var(--diff-add-text);
  }

  .stat .del {
    color: var(--diff-del-text);
  }

  .diff pre {
    display: grid;
    margin: 0;
    padding: 8px 0 12px;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    line-height: 1.85;
    overflow-x: auto;
  }

  .diff code {
    display: grid;
    font-size: inherit;
  }

  .hunk {
    padding-inline: 16px;
    color: var(--text-tertiary);
  }

  .row {
    display: grid;
    grid-template-columns: 44px 20px 1fr;
    white-space: pre;
  }

  .n {
    padding-right: 12px;
    text-align: right;
    color: var(--text-tertiary);
    user-select: none;
  }

  .sign {
    color: var(--text-tertiary);
    user-select: none;
  }

  .row.add {
    background: var(--diff-add-bg);
  }

  .row.del {
    background: var(--diff-del-bg);
  }

  .row.add .sign,
  .row.add .t {
    color: var(--diff-add-text);
  }

  .row.del .sign,
  .row.del .t {
    color: var(--diff-del-text);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
