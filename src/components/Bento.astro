  /* ---- Find and replace ---- */
  .scene-find {
    position: relative;
    height: 232px;
    font-size: 0.875rem;
  }

  .findbar,
  .replacebar {
    position: absolute;
    right: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .findbar {
    top: 12px;
