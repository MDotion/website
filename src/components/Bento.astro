  .find-page {
    padding: 100px 20px 0;
  }

  .find-page p {
    margin: 0;
    padding: 3px 0;
  }

  /* The replacement sits on the match until it takes its place, so the line never has a gap. */
  .hit {
    position: relative;
    display: inline-block;
    padding: 0 1px;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    transition: background-color 200ms ease;
  }

  .hit > span {
    transition:
      opacity 220ms var(--ease-out),
      filter 220ms var(--ease-out);
  }

  .hit .new,
  .scene-find[data-step='3'] .hit .old {
    position: absolute;
    top: 0;
    left: 1px;
  }

  .scene-find[data-step='3'] .hit .new {
    position: static;
  }

  .hit .new {
    opacity: 0;
    filter: blur(2px);
  }

  .scene-find:not([data-step='0']) .hit {
    background: rgba(255, 212, 0, 0.35);
  }

  .scene-find[data-step='1'] .hit:first-of-type,
  .scene-find[data-step='2'] .hit:first-of-type {
