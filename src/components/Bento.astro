  }

  .scene-find[data-step='3'] .hit {
    background: rgba(46, 160, 67, 0.22);
  }

  .scene-find[data-step='3'] .hit .old {
    opacity: 0;
    filter: blur(2px);
  }

  .scene-find[data-step='3'] .hit .new {
