</style>

<script>
  type At = (ms: number, run: () => void) => void;

  type Scene = {
    /** Schedules the scene from its first frame; the player tracks the timers. */
    play: (at: At) => void;
    /** Back to the first frame. */
    reset: () => void;
    /** The last frame, without motion (reduced motion). */
    finish: () => void;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE_IN_OUT = 'cubic-bezier(0.77, 0, 0.175, 1)';

  /** Boolean data attribute: `flag(el, 'done', true)` → `data-done`. */
  function flag(el: HTMLElement, name: string, on: boolean): void {
    el.toggleAttribute(`data-${name}`, on);
  }

  /** Types the element's `data-text` one character at a time; returns when it is done. */
  function typeInto(at: At, el: HTMLElement, start: number, step: number, onType?: (text: string) => void): number {
    const text = el.dataset.text ?? '';
    for (let i = 1; i <= text.length; i += 1) {
      at(start + i * step, () => {
        el.textContent = text.slice(0, i);
        onType?.(text.slice(0, i));
      });
    }
    return start + text.length * step;
  }

  /** Animates elements from where they were to where a DOM change put them (FLIP). */
  function flip(elements: HTMLElement[], change: () => void): void {
    const before = new Map(elements.map((el) => [el, el.getBoundingClientRect()]));
    change();
    for (const el of elements) {
      const was = before.get(el)!;
      const now = el.getBoundingClientRect();
      const dx = was.left - now.left;
      const dy = was.top - now.top;
      if (!dx && !dy) continue;
      el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 420, easing: EASE_IN_OUT });
    }
  }

  /** The Markdown pane of a scene: lines appear, change and get VS Code's gutter marks. */
  function sourceOf(scene: HTMLElement) {
    const code = scene.querySelector<HTMLElement>('.code')!;
    const lines = (id: string) => [...code.querySelectorAll<HTMLElement>(`.line[data-id="${id}"]`)];
    const initial = new Map([...code.querySelectorAll<HTMLElement>('.line')].map((l) => [l, { html: l.innerHTML, hidden: l.hidden }]));
    const flash = (line: HTMLElement) => {
      line.dataset.flash = '';
      requestAnimationFrame(() => requestAnimationFrame(() => delete line.dataset.flash));
    };
    return {
      code,
      /** Shows hidden lines, one after the other, marked as added. */
      add(id: string) {
        lines(id).forEach((line, i) => {
          line.hidden = false;
          line.style.setProperty('--i', String(i));
          line.dataset.new = '';
          line.dataset.mark = 'added';
        });
      },
      /** Replaces the content of lines (HTML highlighted on the server), marked as modified. */
      change(id: string, html: (line: HTMLElement) => string) {
        for (const line of lines(id)) {
          line.innerHTML = html(line);
          line.dataset.mark = 'modified';
          flash(line);
        }
      },
      mark(line: HTMLElement) {
        line.dataset.mark = 'modified';
        flash(line);
      },
      reset() {
        for (const [line, state] of initial) {
          line.innerHTML = state.html;
          line.hidden = state.hidden;
          delete line.dataset.mark;
          delete line.dataset.new;
          delete line.dataset.flash;
        }
      },
    };
  }

  /** The scene's pointer: moves to an element (relative to its pane) and presses. */
  function pointerOf(scene: HTMLElement) {
    const pointer = scene.querySelector<HTMLElement>('.pointer')!;
    const pane = pointer.parentElement!;
    return {
      to(el: Element, dx = 0, dy = 0) {
        const box = pane.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        pointer.style.setProperty('--x', `${r.left - box.left + Math.min(r.width / 2, 34) + dx}px`);
        pointer.style.setProperty('--y', `${r.top - box.top + r.height / 2 - 4 + dy}px`);
        flag(scene, 'pointer', true);
      },
      press: (on: boolean) => flag(scene, 'press', on),
      /** Fades out where it is (moving it while it fades would look like a glitch). */
      hide() {
        flag(scene, 'pointer', false);
        flag(scene, 'press', false);
      },
      reset() {
        pointer.style.removeProperty('--x');
        pointer.style.removeProperty('--y');
        flag(scene, 'pointer', false);
        flag(scene, 'press', false);
      },
    };
  }


  function pasteScene(root: HTMLElement): Scene {
    const source = sourceOf(root);
    const set = (step: number) => (root.dataset.step = String(step));
    return {
      play(at) {
        at(700, () => set(1)); // select A1:C4
        at(1600, () => set(2)); // ⌘C
        at(2500, () => set(3)); // ⌘V at the caret
        at(3100, () => {
          set(4); // the table arrives, and lands in the file
          source.add('pasted');
        });
        at(3700, () => flag(root, 'done', true));
      },
      reset() {
        set(0);
        source.reset();
        flag(root, 'done', false);
      },
      finish() {
        set(4);
        source.add('pasted');
        flag(root, 'done', true);
      },
    };
  }


  function outlineScene(root: HTMLElement): Scene {
    const items = root.querySelector<HTMLElement>('.items')!;
    const sections = root.querySelector<HTMLElement>('.sections')!;
    const dropLine = root.querySelector<HTMLElement>('.drop-line')!;
    const pointer = pointerOf(root);
    const source = sourceOf(root);
    const item = (key: string) => items.querySelector<HTMLElement>(`[data-key="${key}"]`)!;
    const section = (key: string) => sections.querySelector<HTMLElement>(`[data-key="${key}"]`)!;
    const block = (key: string) => source.code.querySelector<HTMLElement>(`.block[data-key="${key}"]`)!;
    const originalItems = [...items.children];
    const originalSections = [...sections.children];
    const originalCode = [...source.code.children];

    const reorder = () => {
      items.insertBefore(item('security'), item('components'));
      sections.insertBefore(section('security'), section('components'));
      source.code.insertBefore(block('security'), block('components'));
    };

    const restore = () => {
      originalItems.forEach((el) => items.appendChild(el));
      originalSections.forEach((el) => sections.appendChild(el));
      originalCode.forEach((el) => source.code.appendChild(el));
    };

    const markMoved = () => {
      for (const line of block('security').querySelectorAll<HTMLElement>('.line')) source.mark(line);
    };

    return {
      play(at) {
        const security = item('security');
        const components = item('components');
        at(500, () => pointer.to(security));
        at(1400, () => {
          pointer.press(true);
          security.dataset.lifted = '';
        });
        at(1700, () => {
          // The dragged item rises; the one it passes moves down to make room.
          const lift = components.getBoundingClientRect().top - security.getBoundingClientRect().top;
          dropLine.style.top = `${components.offsetTop + items.offsetTop - 2}px`;
          security.style.transform = `translateY(${lift}px)`;
          components.style.transform = `translateY(${security.offsetHeight + 2}px)`;
          pointer.to(security, 0, lift);
          flag(root, 'dragging', true);
        });
        at(2600, () => {
          // Drop: both items already show their final place, so swap them in the
          // DOM without motion; the page sections and the file's lines slide.
          for (const el of [security, components]) {
            el.style.transition = 'none';
            el.style.transform = '';
          }
          const codeBlocks = [...source.code.querySelectorAll<HTMLElement>('.block')];
          flip([...(sections.children as HTMLCollectionOf<HTMLElement>), ...codeBlocks], reorder);
          security.getBoundingClientRect();
          security.style.transition = '';
          components.style.transition = '';
          delete security.dataset.lifted;
          section('security').dataset.flash = '';
          markMoved();
          flag(root, 'dragging', false);
          pointer.press(false);
        });
        at(2700, () => delete section('security').dataset.flash);
        at(3200, () => pointer.hide());
        at(3300, () => flag(root, 'done', true));
      },
      reset() {
        for (const key of ['security', 'components']) item(key).style.transform = '';
        delete item('security').dataset.lifted;
        restore();
        source.reset();
        pointer.reset();
        flag(root, 'dragging', false);
        flag(root, 'done', false);
      },
      finish() {
        restore();
        reorder();
        markMoved();
        flag(root, 'done', true);
      },
    };
  }

  function slashScene(root: HTMLElement): Scene {
    const [command, callout] = root.querySelectorAll<HTMLElement>('.typed');
    const source = sourceOf(root);
    const tipText = source.code.querySelector<HTMLElement>('[data-id="tip-text"]')!;
    const set = (step: number) => (root.dataset.step = String(step));
    /** The callout text as it is typed, mirrored in the file. */
    const mirror = (text: string) => {
      tipText.innerHTML = `<span class="m">&gt;</span> ${text.replace(/&/g, '&amp;').replace(/</g, '&lt;')}`;
    };
    const showAlert = () => ['gap', 'tip', 'tip-text'].forEach((id) => source.add(id));
    return {
      play(at) {
        at(600, () => {
          command.textContent = '/';
          set(1);
        });
        const typed = typeInto(at, command, 900, 200); // "/cal"
        at(typed - 200, () => set(2));
        at(typed + 600, () => {
          set(3); // Enter: the callout, and its alert in the file
          showAlert();
        });
        const done = typeInto(at, callout, typed + 900, 40, mirror);
        at(done + 400, () => flag(root, 'done', true));
      },
      reset() {
        command.textContent = '';
        callout.textContent = '';
        source.reset();
        set(0);
        flag(root, 'done', false);
      },
      finish() {
        callout.textContent = callout.dataset.text ?? '';
        set(3);
        showAlert();
        mirror(callout.dataset.text ?? '');
        flag(root, 'done', true);
      },
    };
  }

  function diffScene(root: HTMLElement): Scene {
    const target = root.querySelector<HTMLElement>('[data-target] .box')!;
    const pointer = pointerOf(root);
    const source = sourceOf(root);
    const check = () => {
      flag(root, 'checked', true);
      source.change('todo', (line) => line.dataset.checked!);
    };
    return {
      play(at) {
        at(500, () => pointer.to(target, -2, 2));
        at(1300, () => pointer.press(true));
        at(1450, () => {
          pointer.press(false);
          check();
        });
        at(2000, () => pointer.hide());
        at(2100, () => flag(root, 'done', true));
      },
      reset() {
        pointer.reset();
        source.reset();
        flag(root, 'checked', false);
        flag(root, 'done', false);
      },
      finish() {
        check();
        flag(root, 'done', true);
      },
    };
  }


  function changesScene(root: HTMLElement): Scene {
    const pointer = pointerOf(root);
    const set = (step: number) => (root.dataset.step = String(step));
    const rendered = root.querySelector<HTMLElement>('.seg-rendered')!;
    return {
      play(at) {
        at(500, () => set(1)); // the changed lines arrive
        at(1500, () => set(2)); // their changed words light up
        at(3000, () => pointer.to(rendered));
        at(3800, () => {
          pointer.press(true);
          set(3);
        });
        at(3950, () => {
          pointer.press(false);
          set(4); // Rendered: the same change, on the page
        });
        at(4600, () => pointer.hide());
      },
      reset() {
        set(0);
        pointer.reset();
      },
      finish() {
        set(2);
      },
    };
  }

  function findScene(root: HTMLElement): Scene {
    const [query, replacement] = root.querySelectorAll<HTMLElement>('.typed');
    const count = root.querySelector<HTMLElement>('.find-count')!;
    const set = (step: number) => (root.dataset.step = String(step));
    return {
      play(at) {
        const typed = typeInto(at, query, 400, 170);
        at(typed + 150, () => {
          set(1);
          count.textContent = '1 of 3';
        });
        at(typed + 1000, () => set(2)); // the replace row opens
        const done = typeInto(at, replacement, typed + 1300, 110);
        at(done + 500, () => flag(root, 'press', true));
        at(done + 650, () => {
          flag(root, 'press', false);
          set(3);
          count.textContent = '3 replaced';
        });
      },
      reset() {
        query.textContent = '';
        replacement.textContent = '';
        count.textContent = '';
        flag(root, 'press', false);
        set(0);
      },
      finish() {
        query.textContent = query.dataset.text ?? '';
        replacement.textContent = replacement.dataset.text ?? '';
        count.textContent = '3 replaced';
        set(3);
      },
    };
  }

  function turnScene(root: HTMLElement): Scene {
    const keys = [...root.querySelectorAll<HTMLElement>('.turn-key')];
    const code = root.querySelector<HTMLElement>('.turn-code')!;
    const show = (key: HTMLElement | null) => {
      keys.forEach((k) => flag(k, 'on', k === key));
      root.dataset.kind = key?.dataset.kind ?? 'text';
      code.textContent = key?.dataset.md ?? 'Ship the release';
    };
    return {
      play(at) {
        keys.forEach((key, i) => {
          const t = 600 + i * 1300;
          at(t, () => {
            flag(key, 'press', true);
            show(key);
          });
          at(t + 160, () => flag(key, 'press', false));
        });
        at(600 + keys.length * 1300, () => keys.forEach((k) => flag(k, 'on', false)));
      },
      reset() {
        show(null);
      },
      finish() {
        show(keys[0]);
        flag(keys[0], 'on', false);
      },
    };
  }

  function keysScene(root: HTMLElement): Scene {
    const query = root.querySelector<HTMLElement>('.typed')!;
    const set = (step: number) => (root.dataset.step = String(step));
    return {
      play(at) {
        at(500, () => set(1)); // ⌘⌥K
        at(800, () => flag(root, 'press', true));
        at(950, () => {
          flag(root, 'press', false);
          set(2); // the panel
        });
        const typed = typeInto(at, query, 1600, 160);
        at(typed + 100, () => set(3)); // only the folding shortcuts are left
      },
      reset() {
        query.textContent = '';
        flag(root, 'press', false);
        set(0);
      },
      finish() {
        query.textContent = query.dataset.text ?? '';
        set(3);
      },
    };
  }

  function foldScene(root: HTMLElement): Scene {
    const pointer = pointerOf(root);
    const heading = root.querySelector<HTMLElement>('[data-target] .fold-head')!;
    const key = root.querySelector<HTMLElement>('.fold-key')!;
    return {
      play(at) {
        at(500, () => {
          pointer.to(heading, -36, 0);
          flag(root, 'hover', true);
        });
        at(1300, () => pointer.press(true));
        at(1450, () => {
          pointer.press(false);
          flag(root, 'folded', true);
        });
        at(2000, () => pointer.hide());
        at(3200, () => {
          flag(root, 'key', true);
          flag(key, 'press', true);
        });
        at(3360, () => {
          flag(key, 'press', false);
          flag(root, 'folded', false);
        });
        at(4200, () => {
          flag(root, 'key', false);
          flag(root, 'hover', false);
        });
      },
      reset() {
        pointer.reset();
        for (const name of ['hover', 'folded', 'key']) flag(root, name, false);
      },
      finish() {
        flag(root, 'folded', true);
      },
    };
  }

  function switchScene(root: HTMLElement): Scene {
    const key = root.querySelector<HTMLElement>('.switch-key')!;
    const press = (at: At, t: number, view: string) => {
      at(t, () => {
        flag(root, 'key', true);
        flag(key, 'press', true);
        root.dataset.view = view;
      });
      at(t + 160, () => flag(key, 'press', false));
      at(t + 900, () => flag(root, 'key', false));
    };
    return {
      play(at) {
        press(at, 900, 'markdown');
        press(at, 3400, 'visual');
      },
      reset() {
        root.dataset.view = 'visual';
        flag(root, 'key', false);
      },
      finish() {
        root.dataset.view = 'markdown';
      },
    };
  }

  const builders: Record<string, (root: HTMLElement) => Scene> = {
    changes: changesScene,
    find: findScene,
    turn: turnScene,
    keys: keysScene,
    paste: pasteScene,
    outline: outlineScene,
    slash: slashScene,
    diff: diffScene,
    fold: foldScene,
    switch: switchScene,
  };

  /** How long a tile rests on its last frame before it starts over. */
  const HOLD_MS = 2800;
  /** Tiles that come into view together start a little apart, so they never move in lockstep. */
  const STAGGER_MS = 350;

  for (const bento of document.querySelectorAll<HTMLElement>('.bento')) {
    const tiles = [...bento.querySelectorAll<HTMLElement>('.tile')];

    if (!reduceMotion) {
      // Tiles rise into place once, the first time they come into view.
      bento.dataset.animate = '';
      const entrance = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).dataset.in = '';
              entrance.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -80px 0px' },
      );
      tiles.forEach((tile) => entrance.observe(tile));
    }

    let starting = 0;
    for (const tile of tiles) {
      const root = tile.querySelector<HTMLElement>('[data-scene], .scene')!;
      const name = root.dataset.scene ?? root.className.match(/scene-(\w+)/)?.[1] ?? '';
      const scene = builders[name]?.(root);
      if (!scene) continue;

      if (reduceMotion) {
        scene.finish();
        continue;
      }

      let timers: number[] = [];
      let length = 0;
      const stop = () => {
        timers.forEach(clearTimeout);
        timers = [];
      };
      /** Plays the scene from its first frame, rests on the last one, then fades out and starts over. */
      const loop = (delay: number) => {
        stop();
        // Back to the first frame at once: transitions (some staggered) are for playing, not for resetting.
        root.dataset.resetting = '';
        scene.reset();
        root.getBoundingClientRect();
        delete root.dataset.resetting;
        delete root.dataset.fading;
        length = 0;
        scene.play((ms, run) => {
          length = Math.max(length, ms);
          timers.push(window.setTimeout(run, delay + ms));
        });
        timers.push(window.setTimeout(() => (root.dataset.fading = ''), delay + length + HOLD_MS));
        timers.push(window.setTimeout(() => loop(0), delay + length + HOLD_MS + 260));
      };

      // Play only while the tile is on screen; it starts over when it comes back.
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            loop((starting++ % 3) * STAGGER_MS);
            window.setTimeout(() => (starting = 0), 100);
          } else {
            stop();
          }
        },
        { threshold: 0.5 },
      ).observe(root);
    }
  }
</script>
