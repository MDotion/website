  .find-count {
    flex: none;
    width: 88px;
    font-size: 0.75rem;
    color: var(--e-text-2);
    font-variant-numeric: tabular-nums;
  }

  .find-button {
    flex: none;
    width: 88px;
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--e-text-2);
    text-align: center;
    transition:
