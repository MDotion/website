---
import Logo from './Logo.astro';
import { links } from '../links';
---

<header class="header">
  <div class="container header-inner">
    <a href={import.meta.env.BASE_URL} class="home" aria-label="MDotion home">
      <Logo height={28} />
    </a>
    <nav class="nav" aria-label="Main">
      <a href="#features" class="nav-link hide-mobile">Features</a>
      <a href="#faq" class="nav-link hide-mobile">FAQ</a>
      <a href={links.github} class="nav-link">GitHub</a>
      <a href="#install" class="button button-primary nav-cta">Install</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  /* The hairline only appears once content scrolls under the header. */
  .header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--hairline);
    opacity: 0;
  }

  @supports (animation-timeline: scroll()) {
    .header::after {
      animation: hairline linear both;
      animation-timeline: scroll(root);
      animation-range: 0 64px;
    }
  }

  @supports not (animation-timeline: scroll()) {
    .header::after {
      opacity: 1;
    }
  }

  @keyframes hairline {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .home {
    display: flex;
    color: var(--ink);
    border-radius: 6px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
      background: var(--hover);
    }
  }

  .nav-cta {
    height: 36px;
    padding-inline: 14px;
    margin-left: 8px;
    border-radius: 9px;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }
  }
</style>
