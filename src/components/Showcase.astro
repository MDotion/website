---
// Scripted demos of what MDotion does, played in the same editor mock as the
// hero. Each scene is driven by `data-step` (the script advances it on a
// timeline); everything visual is CSS transitions on transform / opacity.

const scenes = [
  {
    id: 'paste',
    file: 'roadmap.md',
    title: 'Paste a spreadsheet',
    body: 'Copy a range in Excel or Google Sheets, paste it, get a clean GFM table.',
    duration: 7600,
  },
  {
    id: 'outline',
    file: 'architecture.md',
    title: 'Rearrange with the outline',
    body: 'Drag a heading and its whole section moves. In Git, lines just change place.',
    duration: 7600,
  },
  {
    id: 'slash',
    file: 'release-notes.md',
    title: 'Type / for any block',
    body: 'Callouts, to-dos, tables and code, saved as Markdown GitHub renders.',
    duration: 7200,
  },
];

const sheet = [
  ['Feature', 'Owner', 'Points'],
  ['Authentication', 'Ada', '5'],
  ['Notifications', 'Linus', '8'],
  ['Billing', 'Grace', '13'],
];

const sections = [
  { key: 'overview', title: 'Overview', text: 'Four services behind a single gateway.' },
  { key: 'components', title: 'Components', text: 'Gateway, auth, billing and the event store.' },
  { key: 'security', title: 'Security', text: 'Encrypted in transit. Secrets live in the vault.' },
];

const blocks = [
  { icon: 'Aa', title: 'Text', desc: 'Just start writing.' },
  { icon: 'H1', title: 'Heading 1', desc: 'Big section heading.' },
  { icon: '☑', title: 'To-do list', desc: 'Track tasks with a to-do list.' },
  { icon: '💡', title: 'Callout', desc: 'Make writing stand out.' },
  { icon: '▦', title: 'Table', desc: 'Add a simple table.' },
];
---

<section class="section showcase" id="see-it-work">
  <div class="container">
    <div class="head">
      <p class="eyebrow">See it work</p>
      <h2 class="section-title">Not a preview.<br />A page you work in.</h2>
      <p class="lead">Three things you'll do in your first five minutes, and the Markdown each one writes.</p>
    </div>

    <div class="player">
      <div class="tabs" role="tablist" aria-label="Demos">
        {
          scenes.map((s, i) => (
            <button
              type="button"
              role="tab"
              class="tab"
              id={`tab-${s.id}`}
              aria-controls={`scene-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-scene={s.id}
              data-file={s.file}
              data-duration={s.duration}
              style={`--duration: ${s.duration}ms`}
            >
              <span class="tab-title">{s.title}</span>
              <span class="tab-body">{s.body}</span>
              <span class="tab-progress" aria-hidden="true">
                <span />
              </span>
            </button>
          ))
        }
      </div>

      <div class="window editor-palette">
        <div class="toolbar" aria-hidden="true">
          <span class="file">
            <svg width="14" height="14" viewBox="0 0 16 16">
              <path d="M4 1.5h5.2L13 5.3V14a.5.5 0 0 1-.5.5h-8.5A.5.5 0 0 1 3.5 14V2a.5.5 0 0 1 .5-.5Z" fill="currentColor" opacity=".55" />
              <path d="M9 1.5V5a.5.5 0 0 0 .5.5H13" fill="none" stroke="currentColor" opacity=".9" />
            </svg>
            <span class="file-name">{scenes[0].file}</span>
          </span>
          <span class="seg"><span class="on">Visual</span><span>Markdown</span></span>
        </div>

        <div class="scenes">
          <!-- 1. Paste a spreadsheet -->
          <div class="scene scene-paste" id="scene-paste" role="tabpanel" aria-labelledby="tab-paste" data-step="0">
            <div class="page">
              <h3 class="title">Q4 roadmap</h3>
              <p>Pulled from the planning sheet:</p>
              <div class="paste-slot">
                <span class="caret" aria-hidden="true"></span>
                <table class="table" aria-label="Pasted table">
                  {
                    sheet.map((row, r) => (
                      <tr style={`--row: ${r}`}>
                        {row.map((cell, c) =>
                          r === 0 ? <th class:list={{ num: c === 2 }}>{cell}</th> : <td class:list={{ num: c === 2 }}>{cell}</td>,
                        )}
                      </tr>
                    ))
                  }
                </table>
              </div>
            </div>

            <div class="sheet" aria-hidden="true">
              <div class="sheet-bar">
                <span class="sheet-icon"></span>
                Planning · Sheet1
              </div>
              <div class="sheet-grid">
                <span class="corner"></span>
                {['A', 'B', 'C'].map((c) => <span class="col-head">{c}</span>)}
                {
                  sheet.map((row, r) => (
                    <>
                      <span class="row-head">{r + 1}</span>
                      {row.map((cell, c) => (
                        <span class:list={['cell', { bold: r === 0, num: c === 2 && r > 0 }]}>{cell}</span>
                      ))}
                    </>
                  ))
                }
                <span class="sheet-selection"></span>
              </div>
            </div>

            <kbd class="key key-copy" aria-hidden="true">⌘C</kbd>
            <kbd class="key key-paste" aria-hidden="true">⌘V</kbd>

            <div class="peek" aria-label="Markdown written to roadmap.md">
              <span class="peek-head">roadmap.md</span>
              <pre><code><span class="m">|</span> Feature        <span class="m">|</span> Owner <span class="m">|</span> Points <span class="m">|</span>
<span class="m">| -------------- | ----- | -----: |</span>
<span class="m">|</span> Authentication <span class="m">|</span> Ada   <span class="m">|</span> 5      <span class="m">|</span>
<span class="m">|</span> Notifications  <span class="m">|</span> Linus <span class="m">|</span> 8      <span class="m">|</span>
<span class="m">|</span> Billing        <span class="m">|</span> Grace <span class="m">|</span> 13     <span class="m">|</span></code></pre>
            </div>
          </div>

          <!-- 2. Rearrange with the outline -->
          <div class="scene scene-outline" id="scene-outline" role="tabpanel" aria-labelledby="tab-outline" data-step="0" hidden>
            <div class="page outline-page">
              <h3 class="title">Architecture</h3>
              <div class="sections">
                {
                  sections.map((s) => (
                    <div class="sec" data-key={s.key}>
                      <h4>{s.title}</h4>
                      <p>{s.text}</p>
                    </div>
                  ))
                }
              </div>
            </div>

            <aside class="outline" aria-label="Outline">
              <span class="outline-title">Outline</span>
              <span class="item root">Architecture</span>
              <div class="items">
                {
                  sections.map((s) => (
                    <span class="item" data-key={s.key}>
                      {s.title}
                    </span>
                  ))
                }
              </div>
              <span class="drop-line" aria-hidden="true"></span>
            </aside>

            <span class="pointer" aria-hidden="true">
              <svg width="18" height="22" viewBox="0 0 18 22">
                <path d="M1.5 1.5v16.2l4.3-4.1 2.9 6.6 2.9-1.3-2.9-6.5h6z" fill="#0f1419" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
            </span>

            <div class="peek peek-diff" aria-label="Git diff of architecture.md">
              <span class="peek-head">architecture.md <span class="moved">4 lines moved · nothing rewritten</span></span>
              <pre><code><span class="add">+ ## Security</span>
<span class="add">+ Encrypted in transit. Secrets live…</span>
  ## Components
  Gateway, auth, billing and the event…
<span class="del">- ## Security</span>
<span class="del">- Encrypted in transit. Secrets live…</span></code></pre>
            </div>
          </div>

          <!-- 3. Slash menu -->
          <div class="scene scene-slash" id="scene-slash" role="tabpanel" aria-labelledby="tab-slash" data-step="0" hidden>
            <div class="page">
              <h3 class="title">Release notes</h3>
              <p>Version 0.2 ships tables and an outline.</p>
              <p class="typing"><span class="typed" data-text="/cal"></span><span class="caret" aria-hidden="true"></span></p>
              <div class="callout">
                <span aria-hidden="true">💡</span>
                <p><span class="typed" data-text="Ship it on Friday, after the review."></span><span class="caret" aria-hidden="true"></span></p>
              </div>
            </div>

            <div class="menu" aria-hidden="true">
              <span class="menu-section">Basic blocks</span>
              {
                blocks.map((b) => (
                  <span class="menu-item" data-match={b.title === 'Callout' ? 'true' : 'false'}>
                    <span class="menu-icon">{b.icon}</span>
                    <span class="menu-text">
                      <span class="menu-title">{b.title}</span>
                      <span class="menu-desc">{b.desc}</span>
                    </span>
                  </span>
                ))
              }
            </div>

            <div class="peek" aria-label="Markdown written to release-notes.md">
              <span class="peek-head">release-notes.md</span>
              <pre><code><span class="m">&gt; [!TIP]</span>
<span class="m">&gt;</span> Ship it on Friday, after the review.</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 600px;
  }

  .head .section-title {
    margin-top: 12px;
  }

  .head .lead {
    margin-top: 16px;
  }

  .player {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    margin-top: clamp(40px, 6vw, 64px);
  }

  /* Tabs */
  .tabs {
    display: grid;
    gap: 4px;
  }

  .tab {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 18px 18px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    font: inherit;
    text-align: left;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }

  .tab:active {
    transform: scale(0.98);
  }

  .tab[aria-selected='true'] {
    background: var(--bg-subtle);
  }

  @media (hover: hover) and (pointer: fine) {
    .tab:hover {
      background: var(--bg-subtle);
    }
  }

  .tab-title {
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .tab-body {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .tab-progress {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 8px;
    height: 2px;
    overflow: hidden;
    border-radius: 1px;
    background: var(--hairline);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .tab-progress span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .player[data-playing] .tab[aria-selected='true'] .tab-progress {
    opacity: 1;
  }

  .player[data-playing] .tab[aria-selected='true'] .tab-progress span {
    animation: progress var(--duration) linear forwards;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Window */
  .window {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: var(--e-bg);
    color: var(--e-text);
    box-shadow: var(--surface-shadow-lg);
    text-align: left;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 44px;
    padding-inline: 16px;
    font-size: 0.8125rem;
  }

  .file {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--e-text);
  }

  .file svg {
    color: var(--e-text-2);
  }

  .seg {
    display: flex;
    padding: 2px;
    border-radius: 8px;
    background: var(--e-hover);
    color: var(--e-text-2);
  }

  .seg span {
    padding: 2px 9px;
    border-radius: 6px;
  }

  .seg .on {
    background: var(--e-tile);
    color: var(--e-text);
    box-shadow: inset 0 0 0 1px var(--e-divider);
  }

  /* Every scene has the same height, so switching never moves the page. */
  .scenes {
    display: grid;
  }

  .scene {
    position: relative;
    grid-area: 1 / 1;
    height: 420px;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Scene layouts set `display`, which would override the hidden attribute. */
  .scene[hidden] {
    display: none;
  }

  .scene:not([hidden]) {
    animation: scene-in 240ms var(--ease-out);
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      filter: blur(3px);
    }
  }

  .page {
    padding: 20px 36px;
  }

  .page p {
    margin: 0;
  }

  .title {
    margin: 0 0 8px;
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 700;
    color: inherit;
  }

  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--e-text);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Markdown peek: what the scene wrote to disk. */
  .peek {
    position: absolute;
    right: 16px;
    bottom: 16px;
    max-width: calc(100% - 32px);
    padding: 10px 14px 12px;
    border-radius: 10px;
    background: var(--e-popover);
    box-shadow: var(--e-popover-shadow);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 240ms var(--ease-out),
      transform 240ms var(--ease-out);
  }

  .peek-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 0.75rem;
    color: var(--e-text-2);
  }

  .peek pre {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre;
    overflow: hidden;
  }

  .peek code {
    font-size: inherit;
  }

  .peek .m {
    color: var(--e-text-3);
  }

  .key {
    position: absolute;
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--e-popover);
    box-shadow: var(--e-popover-shadow);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--e-text);
    opacity: 0;
    transform: translateY(4px) scale(0.96);
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  /* ---- Scene 1: paste a spreadsheet ---- */
  .paste-slot {
    position: relative;
    min-height: 26px;
    margin-top: 10px;
  }

  .scene-paste .caret {
    position: absolute;
    top: 3px;
    left: 0;
  }

  /* Borders belong to the cells (not a collapsed table), so each row brings its own in. */
  .table {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.875rem;
  }

  .table th,
  .table td {
    padding: 5px 10px;
    border-right: 1px solid var(--e-divider-strong);
    border-bottom: 1px solid var(--e-divider-strong);
    text-align: left;
    white-space: nowrap;
  }

  .table tr:first-child > * {
    border-top: 1px solid var(--e-divider-strong);
  }

  .table tr > :first-child {
    border-left: 1px solid var(--e-divider-strong);
  }

  .table th {
    background: var(--e-table-header);
    font-weight: 500;
  }

  .table .num {
    text-align: right;
  }

  .table tr {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
    transition-delay: calc(var(--row) * 60ms);
  }

  .sheet {
    position: absolute;
    top: 20px;
    right: 24px;
    width: 300px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--e-popover);
    box-shadow: var(--e-popover-shadow);
    font-size: 0.75rem;
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .sheet-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--e-divider);
    color: var(--e-text-2);
  }

  .sheet-icon {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: #1e8e3e;
  }

  .sheet-grid {
    position: relative;
    display: grid;
    grid-template-columns: 24px 1.6fr 1fr 0.8fr;
  }

  .sheet-grid > span {
    padding: 4px 6px;
    border-right: 1px solid var(--e-divider);
    border-bottom: 1px solid var(--e-divider);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .corner,
  .col-head,
  .row-head {
    background: var(--e-table-header);
    color: var(--e-text-3);
    text-align: center;
  }

  .cell.bold {
    font-weight: 600;
  }

  .cell.num {
    text-align: right;
  }

  /* Selection over A1:C4, revealed from the first cell like a drag. */
  .sheet-grid > .sheet-selection {
    position: absolute;
    top: calc(100% / 5);
    left: 24px;
    right: 0;
    bottom: 0;
    padding: 0;
    border: 2px solid #1a73e8;
    border-radius: 2px;
    background: rgba(26, 115, 232, 0.1);
    clip-path: inset(0 100% 100% 0);
    transition: clip-path 600ms var(--ease-in-out);
  }

  .key-copy {
    top: 196px;
    right: 132px;
  }

  .key-paste {
    top: 128px;
    left: 52px;
  }

  .scene-paste[data-step='1'] .sheet-selection,
  .scene-paste[data-step='2'] .sheet-selection,
  .scene-paste[data-step='3'] .sheet-selection,
  .scene-paste[data-step='4'] .sheet-selection,
  .scene-paste[data-step='5'] .sheet-selection {
    clip-path: inset(0 0 0 0);
  }

  .scene-paste[data-step='2'] .key-copy,
  .scene-paste[data-step='3'] .key-paste {
    opacity: 1;
    transform: none;
  }

  .scene-paste[data-step='4'] .sheet,
  .scene-paste[data-step='5'] .sheet {
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
  }

  .scene-paste[data-step='4'] .caret,
  .scene-paste[data-step='5'] .caret {
    visibility: hidden;
  }

  .scene-paste[data-step='4'] .table tr,
  .scene-paste[data-step='5'] .table tr {
    opacity: 1;
    transform: none;
  }

  .scene-paste[data-step='5'] .peek {
    opacity: 1;
    transform: none;
  }

  /* ---- Scene 2: rearrange with the outline ---- */
  .scene-outline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
  }

  .sections {
    display: grid;
    gap: 4px;
  }

  .sec {
    padding: 4px 8px;
    margin-inline: -8px;
    border-radius: 6px;
    transition: background-color 600ms ease;
  }

  .sec h4 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 700;
    color: inherit;
  }

  .sec p {
    color: var(--e-text-2);
  }

  .sec[data-flash] {
    background: var(--e-selection);
    transition: none;
  }

  .outline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 10px;
    border-left: 1px solid var(--e-divider);
    font-size: 0.8125rem;
  }

  .outline-title {
    padding: 0 8px 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--e-text-2);
  }

  .items {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item {
    position: relative;
    padding: 4px 8px 4px 22px;
    border-radius: 6px;
    color: var(--e-text-2);
    white-space: nowrap;
    background: var(--e-bg);
    transition:
      transform 420ms var(--ease-in-out),
      box-shadow 150ms ease,
      background-color 150ms ease;
  }

  .item.root {
    padding-left: 8px;
    color: var(--e-text);
    font-weight: 500;
  }

  .item[data-lifted] {
    z-index: 1;
    background: var(--e-popover);
    box-shadow: var(--e-popover-shadow);
    color: var(--e-text);
  }

  .drop-line {
    position: absolute;
    left: 18px;
    right: 10px;
    height: 2px;
    border-radius: 1px;
    background: var(--e-accent);
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .scene-outline[data-step='3'] .drop-line {
    opacity: 1;
  }

  .pointer {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    opacity: 0;
    transform: translate(var(--x, 60%), var(--y, 80%));
    transition:
      transform 700ms var(--ease-in-out),
      opacity 200ms ease;
    pointer-events: none;
  }

  .scene-outline[data-step='1'] .pointer,
  .scene-outline[data-step='2'] .pointer,
  .scene-outline[data-step='3'] .pointer,
  .scene-outline[data-step='4'] .pointer {
    opacity: 1;
  }

  .scene-outline[data-step='2'] .pointer svg,
  .scene-outline[data-step='3'] .pointer svg {
    transform: scale(0.9);
  }

  .pointer svg {
    transition: transform 120ms var(--ease-out);
  }

  .moved {
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--diff-add-bg);
    color: var(--diff-add-text);
  }

  .peek-diff .add {
    color: var(--diff-add-text);
  }

  .peek-diff .del {
    color: var(--diff-del-text);
  }

  .scene-outline .peek {
    right: 206px;
  }

  .scene-outline[data-step='5'] .peek {
    opacity: 1;
    transform: none;
  }

  /* ---- Scene 3: slash menu ---- */
  .typing {
    min-height: 1.5em;
    margin-top: 10px !important;
  }

  .scene-slash .callout {
    display: flex;
    gap: 10px;
    margin-top: 10px;
    padding: 12px 14px;
    border-radius: 4px;
    background: var(--e-callout);
    opacity: 0;
    transform: scale(0.98);
    transform-origin: top left;
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .scene-slash .callout .caret {
    visibility: hidden;
  }

  .menu {
    position: absolute;
    top: 152px;
    left: 36px;
    width: 280px;
    padding: 6px 0;
    border-radius: 10px;
    background: var(--e-popover);
    box-shadow: var(--e-popover-shadow);
    font-size: 0.8125rem;
    opacity: 0;
    transform: scale(0.97);
    transform-origin: top left;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
    pointer-events: none;
  }

  .menu-section {
    display: block;
    padding: 4px 12px 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--e-text-2);
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 4px;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .menu-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 5px;
    background: var(--e-tile);
    box-shadow: inset 0 0 0 1px var(--e-divider-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--e-text-2);
  }

  .menu-text {
    display: grid;
  }

  .menu-title {
    color: var(--e-text);
  }

  .menu-desc {
    font-size: 0.75rem;
    color: var(--e-text-2);
  }

  /* Typing "/" opens the menu; "/cal" filters it down to Callout. */
  .scene-slash[data-step='1'] .menu,
  .scene-slash[data-step='2'] .menu {
    opacity: 1;
    transform: none;
  }

  .scene-slash[data-step='2'] .menu-item[data-match='false'] {
    display: none;
  }

  .scene-slash[data-step='2'] .menu-item[data-match='true'] {
    background: var(--e-hover);
  }

  .scene-slash[data-step='3'] .typing,
  .scene-slash[data-step='4'] .typing {
    display: none;
  }

  .scene-slash[data-step='3'] .callout,
  .scene-slash[data-step='4'] .callout {
    opacity: 1;
    transform: none;
  }

  .scene-slash[data-step='3'] .callout .caret {
    visibility: visible;
  }

  .scene-slash[data-step='4'] .peek {
    opacity: 1;
    transform: none;
  }

  /* Reduced motion: no autoplay; each scene shows its result. */
  .player[data-static] .scene * {
    transition: none !important;
  }

  .player[data-static] .caret {
    animation: none;
  }

  @media (max-width: 860px) {
    .player {
      grid-template-columns: minmax(0, 1fr);
    }

    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tab {
      padding: 12px 12px 16px;
    }

    .tab-body {
      display: none;
    }

    .tab-progress {
      left: 12px;
      right: 12px;
    }
  }

  @media (max-width: 640px) {
    .scene {
      height: 400px;
      font-size: 0.875rem;
    }

    .page {
      padding: 16px 18px;
    }

    .title {
      font-size: 1.375rem;
    }

    .sheet {
      top: auto;
      bottom: 16px;
      right: 12px;
      left: 12px;
      width: auto;
    }

    .key-copy {
      top: auto;
      bottom: 150px;
      right: 24px;
    }

    .key-paste {
      top: 112px;
      left: 18px;
    }

    .scene-outline {
      grid-template-columns: minmax(0, 1fr) 132px;
    }

    /* Narrow page: the headings tell the story, the diff needs the room. */
    .sec p {
      display: none;
    }

    .outline {
      padding-inline: 4px;
    }

    .item {
      padding-left: 14px;
    }

    .scene-outline .peek {
      right: 12px;
      left: 12px;
    }

    .peek {
      right: 12px;
      left: 12px;
      max-width: none;
    }

    .menu {
      top: 136px;
      left: 18px;
      width: min(260px, calc(100% - 36px));
    }

    .tab-title {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene:not([hidden]) {
      animation: none;
    }

    .tab:active {
      transform: none;
    }
  }
</style>

<script>
  type Scene = {
    /** Schedules the scene from its first step; returns nothing, timers are tracked by the player. */
    play: (at: (ms: number, run: () => void) => void) => void;
    /** Back to the first frame. */
    reset: () => void;
    /** The last frame, without motion (reduced motion). */
    finish: () => void;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Types `text` into `el` one character at a time, starting at `start`. */
  function typeInto(at: (ms: number, run: () => void) => void, el: HTMLElement, start: number, step: number): number {
    const text = el.dataset.text ?? '';
    for (let i = 1; i <= text.length; i += 1) {
      at(start + i * step, () => (el.textContent = text.slice(0, i)));
    }
    return start + text.length * step;
  }

  /** Animates elements from where they were to where a DOM change put them (FLIP). */
  function flip(elements: HTMLElement[], change: () => void): void {
    const before = new Map(elements.map((el) => [el, el.getBoundingClientRect().top]));
    change();
    for (const el of elements) {
      const delta = before.get(el)! - el.getBoundingClientRect().top;
      if (!delta) continue;
      el.animate([{ transform: `translateY(${delta}px)` }, { transform: 'none' }], {
        duration: 420,
        easing: 'cubic-bezier(0.77, 0, 0.175, 1)',
      });
    }
  }

  function pasteScene(root: HTMLElement): Scene {
    const set = (step: number) => (root.dataset.step = String(step));
    return {
      play(at) {
        at(700, () => set(1)); // select A1:C4
        at(1600, () => set(2)); // ⌘C
        at(2500, () => set(3)); // ⌘V at the caret
        at(3100, () => set(4)); // the table appears
        at(4300, () => set(5)); // the Markdown on disk
      },
      reset: () => set(0),
      finish: () => set(5),
    };
  }

  function outlineScene(root: HTMLElement): Scene {
    const items = root.querySelector<HTMLElement>('.items')!;
    const sections = root.querySelector<HTMLElement>('.sections')!;
    const pointer = root.querySelector<HTMLElement>('.pointer')!;
    const dropLine = root.querySelector<HTMLElement>('.drop-line')!;
    const item = (key: string) => items.querySelector<HTMLElement>(`[data-key="${key}"]`)!;
    const section = (key: string) => sections.querySelector<HTMLElement>(`[data-key="${key}"]`)!;
    const originalItems = [...items.children];
    const originalSections = [...sections.children];
    const set = (step: number) => (root.dataset.step = String(step));

    /** Moves the pointer to the middle-left of `el`. */
    const pointAt = (el: HTMLElement, dy = 0) => {
      const box = root.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      pointer.style.setProperty('--x', `${r.left - box.left + 34}px`);
      pointer.style.setProperty('--y', `${r.top - box.top + r.height / 2 - 4 + dy}px`);
    };

    const reorder = () => {
      items.insertBefore(item('security'), item('components'));
      sections.insertBefore(section('security'), section('components'));
    };

    const restore = () => {
      originalItems.forEach((el) => items.appendChild(el));
      originalSections.forEach((el) => sections.appendChild(el));
    };

    return {
      play(at) {
        const security = item('security');
        const components = item('components');
        let lift = 0;
        at(500, () => {
          pointAt(security);
          set(1);
        });
        at(1500, () => {
          security.dataset.lifted = '';
          set(2);
        });
        at(1800, () => {
          lift = components.getBoundingClientRect().top - security.getBoundingClientRect().top;
          dropLine.style.top = `${components.offsetTop + items.offsetTop - 2}px`;
          // The dragged item rises; the one it passes moves down to make room.
          security.style.transform = `translateY(${lift}px)`;
          components.style.transform = `translateY(${security.offsetHeight + 2}px)`;
          pointAt(security, lift);
          set(3);
        });
        at(2700, () => {
          // Drop: both items already show their final place, so swap them in the
          // DOM without motion; the page sections slide into the new order.
          for (const el of [security, components]) {
            el.style.transition = 'none';
            el.style.transform = '';
          }
          flip([...(sections.children as HTMLCollectionOf<HTMLElement>)], reorder);
          security.getBoundingClientRect();
          security.style.transition = '';
          components.style.transition = '';
          delete security.dataset.lifted;
          section('security').dataset.flash = '';
          set(4);
        });
        at(2800, () => delete section('security').dataset.flash);
        at(3700, () => set(5));
      },
      reset() {
        const security = item('security');
        security.style.transform = '';
        item('components').style.transform = '';
        delete security.dataset.lifted;
        restore();
        pointer.style.removeProperty('--x');
        pointer.style.removeProperty('--y');
        set(0);
      },
      finish() {
        restore();
        reorder();
        set(5);
      },
    };
  }

  function slashScene(root: HTMLElement): Scene {
    const [command, callout] = root.querySelectorAll<HTMLElement>('.typed');
    const set = (step: number) => (root.dataset.step = String(step));
    return {
      play(at) {
        at(600, () => {
          command.textContent = '/';
          set(1);
        });
        const typed = typeInto(at, command, 900, 200); // "/cal"
        at(typed - 200, () => set(2));
        at(typed + 600, () => set(3)); // Enter: the callout
        const done = typeInto(at, callout, typed + 900, 40);
        at(done + 500, () => set(4));
      },
      reset() {
        command.textContent = '';
        callout.textContent = '';
        set(0);
      },
      finish() {
        callout.textContent = callout.dataset.text ?? '';
        set(4);
      },
    };
  }

  for (const player of document.querySelectorAll<HTMLElement>('.player')) {
    const tabs = [...player.querySelectorAll<HTMLButtonElement>('.tab')];
    const fileName = player.querySelector<HTMLElement>('.file-name')!;
    const scenes = new Map<string, Scene>([
      ['paste', pasteScene(player.querySelector('.scene-paste')!)],
      ['outline', outlineScene(player.querySelector('.scene-outline')!)],
      ['slash', slashScene(player.querySelector('.scene-slash')!)],
    ]);
    let current = 0;
    let timers: number[] = [];
    let visible = false;

    const stop = () => {
      timers.forEach(clearTimeout);
      timers = [];
      delete player.dataset.playing;
    };

    const select = (index: number) => {
      stop();
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = player.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)!;
        panel.hidden = !on;
        scenes.get(tab.dataset.scene!)!.reset();
      });
      fileName.textContent = tabs[index].dataset.file ?? '';
      const scene = scenes.get(tabs[index].dataset.scene!)!;
      if (reduceMotion) {
        scene.finish();
        return;
      }
      if (!visible) return;
      // Restart the progress bar animation.
      player.getBoundingClientRect();
      player.dataset.playing = '';
      scene.play((ms, run) => timers.push(window.setTimeout(run, ms)));
      timers.push(window.setTimeout(() => select((index + 1) % tabs.length), Number(tabs[index].dataset.duration)));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1;
        const next = (i + step + tabs.length) % tabs.length;
        tabs[next].focus();
        select(next);
      });
    });

    if (reduceMotion) {
      player.dataset.static = '';
      select(0);
      continue;
    }

    // Play only while the demo is on screen; start the current scene over when it comes back.
    new IntersectionObserver(
      ([entry]) => {
        const nowVisible = entry.isIntersecting;
        if (nowVisible === visible) return;
        visible = nowVisible;
        if (visible) {
          select(current);
        } else {
          stop();
        }
      },
      { threshold: 0.4 },
    ).observe(player.querySelector('.window')!);

    select(0);
  }
</script>
